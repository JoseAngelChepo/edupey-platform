# Copy to .env.local (Next.js loads .env.local in development)

NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Prefer same-origin /api/v1 so auth cookies stay first-party (see next.config.ts rewrite).
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_ORIGIN=http://localhost:3001

# --- Production (recommended) ---
# NEXT_PUBLIC_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-app.example
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_ORIGIN=https://your-api.example
#
# Or call the API host directly (requires services cookies SameSite=None + CORS):
# NEXT_PUBLIC_API_URL=https://your-api.example/api/v1

# Required if template-services expects HTTP Basic on unauthenticated routes (format: username:password)
# NEXT_PUBLIC_API_BASIC_AUTH=user:password
